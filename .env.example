# Optional. Only agents/llm_agent.py reads these, to measure difficulty against a
# real model. The challenge, grader, solver, tests and scripted calibration do not
# need any key. Any OpenAI-compatible endpoint works.
LLM_API_KEY=your-key-here
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b

# Only when the challenge runs in a container and the env connects over HTTP.
# Must match the value the container was started with.
# AR_ADMIN_TOKEN=local-admin-token
